"@import \"tailwindcss\" source(none);\n@source \"../src\";\n@import \"tw-animate-css\";\n\n@custom-variant dark (&:is(.dark *));\n\n@theme inline {\n  --font-display: \"Archivo Black\", system-ui, sans-serif;\n  --font-sans: \"Hind\", system-ui, sans-serif;\n\n  --radius-sm: calc(var(--radius) - 4px);\n  --radius-md: calc(var(--radius) - 2px);\n  --radius-lg: var(--radius);\n  --radius-xl: calc(var(--radius) + 4px);\n  --radius-2xl: calc(var(--radius) + 8px);\n  --radius-3xl: calc(var(--radius) + 12px);\n\n  --color-background: var(--background);\n  --color-foreground: var(--foreground);\n  --color-card: var(--card);\n  --color-card-foreground: var(--card-foreground);\n  --color-popover: var(--popover);\n  --color-popover-foreground: var(--popover-foreground);\n  --color-primary: var(--primary);\n  --color-primary-foreground: var(--primary-foreground);\n  --color-secondary: var(--secondary);\n  --color-secondary-foreground: var(--secondary-foreground);\n  --color-muted: var(--muted);\n  --color-muted-foreground: var(--muted-foreground);\n  --color-accent: var(--accent);\n  --color-accent-foreground: var(--accent-foreground);\n  --color-destructive: var(--destructive);\n  --color-destructive-foreground: var(--destructive-foreground);\n  --color-border: var(--border);\n  --color-input: var(--input);\n  --color-ring: var(--ring);\n  --color-ember: var(--ember);\n  --color-ember-foreground: var(--ember-foreground);\n  --color-nav-glow-start: var(--nav-glow-start);\n  --color-nav-glow-end: var(--nav-glow-end);\n}\n\n:root {\n  --radius: 0.5rem;\n\n  /* Pink Theme */\n  --background: oklch(0.15 0.05 350);\n  --foreground: oklch(0.98 0.01 350);\n  --card: oklch(0.18 0.06 350);\n  --card-foreground: oklch(0.98 0.01 350);\n  --popover: oklch(0.18 0.06 350);\n  --popover-foreground: oklch(0.98 0.01 350);\n  --primary: oklch(0.65 0.2 350);\n  --primary-foreground: oklch(0.98 0.01 350);\n  --secondary: oklch(0.25 0.08 350);\n  --secondary-foreground: oklch(0.98 0.01 350);\n  --muted: oklch(0.25 0.08 350);\n  --muted-foreground: oklch(0.7 0.05 350);\n  --accent: oklch(0.65 0.2 350);\n  --accent-foreground: oklch(0.98 0.01 350);\n  --destructive: oklch(0.45 0.2 25);\n  --destructive-foreground: oklch(0.98 0.01 350);\n  --border: oklch(0.3 0.08 350);\n  --input: oklch(0.25 0.08 350);\n  --ring: oklch(0.65 0.2 350);\n  --ember: oklch(0.65 0.2 350);\n  --ember-foreground: oklch(0.98 0.01 350);\n  --nav-glow-start: oklch(0.65 0.2 350 / 0.4);\n  --nav-glow-end: oklch(0.65 0.2 350 / 0.1);\n}\n\nhtml.dark {\n  --background: oklch(0.1 0.04 350);\n  --foreground: oklch(0.98 0.01 350);\n  --card: oklch(0.13 0.05 350);\n  --card-foreground: oklch(0.98 0.01 350);\n  --popover: oklch(0.13 0.05 350);\n  --popover-foreground: oklch(0.98 0.01 350);\n  --primary: oklch(0.65 0.2 350);\n  --primary-foreground: oklch(0.98 0.01 350);\n  --secondary: oklch(0.2 0.07 350);\n  --secondary-foreground: oklch(0.98 0.01 350);\n  --muted: oklch(0.2 0.07 350);\n  --muted-foreground: oklch(0.65 0.05 350);\n  --accent: oklch(0.65 0.2 350);\n  --accent-foreground: oklch(0.98 0.01 350);\n  --destructive: oklch(0.4 0.2 25);\n  --destructive-foreground: oklch(0.98 0.01 350);\n  --border: oklch(0.25 0.07 350);\n  --input: oklch(0.2 0.07 350);\n  --ring: oklch(0.65 0.2 350);\n  --ember: oklch(0.65 0.2 350);\n  --ember-foreground: oklch(0.98 0.01 350);\n  --nav-glow-start: oklch(0.65 0.2 350 / 0.4);\n  --nav-glow-end: oklch(0.65 0.2 350 / 0.1);\n}\n\n@layer base {\n  * {\n    border-color: var(--color-border);\n  }\n\n  html, body {\n    background-color: var(--color-background);\n    color: var(--color-foreground);\n    font-family: var(--font-sans);\n    -webkit-font-smoothing: antialiased;\n  }\n\n  h1, h2, h3, h4, .font-display {\n    font-family: var(--font-display);\n    letter-spacing: -0.01em;\n  }\n}\n\n\n@keyframes ember-glow {\n  0%, 100% {\n    box-shadow: 0 0 0 0 color-mix(in oklab, var(--ember) 70%, transparent),\n                0 0 8px 2px color-mix(in oklab, var(--ember) 40%, transparent);\n    transform: scale(1);\n  }\n  50% {\n    box-shadow: 0 0 0 6px color-mix(in oklab, var(--ember) 0%, transparent),\n                0 0 14px 4px color-mix(in oklab, var(--ember) 60%, transparent);\n    transform: scale(1.15);\n  }\n}\n\n@keyframes ember-flicker {\n  0%, 100% { opacity: 1; }\n  45% { opacity: 0.55; }\n  55% { opacity: 1; }\n}\n\n@keyframes ember-shimmer {\n  0% { background-position: 0% 50%; }\n  100% { background-position: 200% 50%; }\n}\n\n@keyframes ember-float {\n  0%, 100% { transform: translateY(0); }\n  50% { transform: translateY(-2px); }\n}\n\n.ember-dot {\n  animation: ember-glow 2.2s ease-in-out infinite;\n}\n\n.ember-accent {\n  display: inline-block;\n  animation: ember-flicker 3s ease-in-out infinite;\n}\n\n.ember-logo .ember-word {\n  display: inline-block;\n  background-image: linear-gradient(90deg, oklch(0.65 0.2 350) 0%, oklch(0.8 0.14 350) 50%, oklch(0.65 0.2 350) 100%);\n  background-size: 200% 100%;\n  -webkit-background-clip: text;\n  background-clip: text;\n  color: transparent;\n  animation: ember-shimmer 4s linear infinite, ember-float 3.5s ease-in-out infinite;\n  transition: letter-spacing 0.4s ease;\n}\n\n.ember-logo:hover .ember-word {\n  letter-spacing: 0.12em;\n}\n\n.ember-logo:hover .ember-dot {\n  animation-duration: 0.9s;\n}\n\n\n\n.ember-shimmer-text {\n  background-image: linear-gradient(90deg, #FFFFFF 0%, #A3A3A3 50%, #FFFFFF 100%);\n  background-size: 200% 100%;\n  -webkit-background-clip: text;\n  background-clip: text;\n  color: transparent;\n  animation: ember-shimmer 4s linear infinite;\n}\n\n@keyframes ember-search-glow {\n  0%, 100% {\n    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.2),\n                0 0 12px -2px rgba(255, 255, 255, 0.15);\n  }\n  50% {\n    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.4),\n                0 0 22px 0px rgba(255, 255, 255, 0.2);\n  }\n}\n\n@keyframes ember-search-border {\n  0% { background-position: 0% 50%; }\n  100% { background-position: 200% 50%; }\n}\n\n.ember-search {\n  position: relative;\n  border-radius: 0.5rem;\n  padding: 1px;\n  background: linear-gradient(90deg, oklch(0.3 0.08 350), oklch(0.65 0.2 350), oklch(0.3 0.08 350));\n  background-size: 200% 100%;\n  animation: ember-search-border 4s linear infinite, ember-search-glow 3s ease-in-out infinite;\n}\n\n.ember-search > input {\n  border: none !important;\n  background: var(--background) !important;\n}\n\n.ember-search > svg {\n  z-index: 1;\n}\n\n.ember-search:focus-within {\n  animation-duration: 1.5s, 1.5s;\n}\n\n@keyframes badge-destaque-pulse {\n  0%, 100% {\n    box-shadow: 0 4px 20px -4px rgba(255, 255, 255, 0.2), 0 0 0 0 rgba(255, 255, 255, 0.1);\n    transform: translateY(0);\n  }\n  50% {\n    box-shadow: 0 8px 28px -4px rgba(255, 255, 255, 0.4), 0 0 0 6px rgba(255, 255, 255, 0);\n    transform: translateY(-1px);\n  }\n}\n\n@keyframes badge-destaque-shine {\n  0% { transform: translateX(-120%) skewX(-20deg); }\n  60%, 100% { transform: translateX(220%) skewX(-20deg); }\n}\n\n.badge-destaque {\n  animation: badge-destaque-pulse 2.6s ease-in-out infinite;\n  background-size: 200% 100%;\n}\n\n.badge-destaque__shine {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background: linear-gradient(90deg, transparent 0%, oklch(0.65 0.2 350 / 0.5) 50%, transparent 100%);\n  width: 40%;\n  animation: badge-destaque-shine 2.8s ease-in-out infinite;\n}\n\n@keyframes headline-shimmer-sweep {\n  0% { background-position: -150% 0; }\n  100% { background-position: 250% 0; }\n}\n\n.headline-shimmer {\n  background-image: linear-gradient(\n    100deg,\n    hsl(var(--foreground)) 0%,\n    hsl(var(--foreground)) 40%,\n    #FFFFFF 50%,\n    #A3A3A3 55%,\n    hsl(var(--foreground)) 65%,\n    hsl(var(--foreground)) 100%\n  );\n  background-size: 250% 100%;\n  background-repeat: no-repeat;\n  -webkit-background-clip: text;\n  background-clip: text;\n  -webkit-text-fill-color: transparent;\n  color: transparent;\n  animation: headline-shimmer-sweep 4.5s linear infinite;\n}\n\n@keyframes video-aurora-drift {\n  0%   { transform: translate3d(-10%, -10%, 0) rotate(0deg) scale(1.1); }\n  50%  { transform: translate3d(10%, 5%, 0) rotate(180deg) scale(1.3); }\n  100% { transform: translate3d(-10%, -10%, 0) rotate(360deg) scale(1.1); }\n}\n\n@keyframes video-aurora-drift-2 {\n  0%   { transform: translate3d(10%, 10%, 0) rotate(0deg) scale(1.2); }\n  50%  { transform: translate3d(-12%, -8%, 0) rotate(-180deg) scale(1); }\n  100% { transform: translate3d(10%, 10%, 0) rotate(-360deg) scale(1.2); }\n}\n\n.video-aurora {\n  background: conic-gradient(from 0deg at 50% 50%, oklch(0.25 0.08 350), oklch(0.12 0.04 350), oklch(0.25 0.08 350));\n  filter: blur(60px);\n  opacity: 0.35;\n  animation: video-aurora-drift 14s linear infinite;\n}\n\n.video-aurora-2 {\n  background: radial-gradient(circle at 30% 30%, oklch(0.3 0.09 350) 0%, transparent 55%),\n              radial-gradient(circle at 70% 70%, oklch(0.18 0.05 350) 0%, transparent 55%);\n  filter: blur(50px);\n  opacity: 0.4;\n  mix-blend-mode: screen;\n  animation: video-aurora-drift-2 18s ease-in-out infinite;\n}\n\n#lovable-badge {\n  display: none !important;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.001ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.001ms !important;\n    scroll-behavior: auto !important;\n  }\n  .video-aurora, .video-aurora-2 { animation: none !important; opacity: 0.35; }\n}\n\n@keyframes content-fade-in {\n  from { opacity: 0; transform: translateY(10px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\nmain > section {\n  animation: content-fade-in 0.8s ease-out forwards;\n}\n\n.article-card-hover {\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.article-card-hover:hover {\n  transform: translateY(-4px) scale(1.02);\n  box-shadow: 0 20px 25px -5px rgba(255, 255, 255, 0.05), 0 10px 10px -5px rgba(255, 255, 255, 0.02);\n}\n"